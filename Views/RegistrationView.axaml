<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BoardGame.Views.RegistrationView"
             Tag="Регистрация">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Border Classes="card" Width="560" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="14">
                <StackPanel Spacing="2">
                    <TextBlock Classes="h1" Text="Регистрация покупателя"/>
                    <TextBlock Classes="muted" Text="После регистрации вы сможете заказывать игры с самовывозом"/>
                </StackPanel>

                <Grid ColumnDefinitions="*,14,*" RowDefinitions="Auto,14,Auto,14,Auto">
                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="ИМЯ" Classes="label"/>
                        <TextBox x:Name="RegFirstName" PlaceholderText="Иван"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="ФАМИЛИЯ" Classes="label"/>
                        <TextBox x:Name="RegLastName" PlaceholderText="Иванов"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="ТЕЛЕФОН" Classes="label"/>
                        <TextBox x:Name="RegPhone" PlaceholderText="+7 999 123-45-67"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Text="EMAIL" Classes="label"/>
                        <TextBox x:Name="RegEmail" PlaceholderText="name@mail.ru"/>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="0">
                        <TextBlock Text="ЛОГИН" Classes="label"/>
                        <TextBox x:Name="RegLogin" PlaceholderText="Придумайте логин"/>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="2">
                        <TextBlock Text="ПАРОЛЬ" Classes="label"/>
                        <TextBox x:Name="RegPassword" PasswordChar="•" PlaceholderText="Не менее 4 символов"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                    <Button x:Name="SubmitButton" Content="Зарегистрироваться" Classes="primary" Click="SubmitClick"/>
                    <Button Content="Отмена" Classes="ghost" Click="CancelClick"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
