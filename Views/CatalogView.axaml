<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BoardGame.Views.CatalogView"
             Tag="Каталог игр">

    <DockPanel>

        <!-- ВЕРХНЯЯ ПАНЕЛЬ: заголовок, поиск, фильтр и сортировка -->
        <StackPanel DockPanel.Dock="Top" Spacing="14" Margin="0,0,0,16">
            <StackPanel Spacing="2">
                <TextBlock Classes="h1" Text="Каталог настольных игр"/>
                <TextBlock x:Name="SubtitleText" Classes="muted"
                           Text="Выберите игру, чтобы посмотреть описание и добавить её в корзину"/>
            </StackPanel>

            <Grid ColumnDefinitions="*,190,200,Auto">
                <TextBox Grid.Column="0" x:Name="SearchBox"
                         PlaceholderText="Поиск по названию, артикулу или описанию..."
                         TextChanged="SearchChanged"/>

                <ComboBox Grid.Column="1" x:Name="CategoryBox" Margin="10,0,0,0"
                          HorizontalAlignment="Stretch" SelectionChanged="FilterChanged"/>

                <ComboBox Grid.Column="2" x:Name="SortBox" Margin="10,0,0,0"
                          HorizontalAlignment="Stretch" SelectionChanged="FilterChanged">
                    <ComboBoxItem Content="По названию"/>
                    <ComboBoxItem Content="Цена: по возрастанию"/>
                    <ComboBoxItem Content="Цена: по убыванию"/>
                    <ComboBoxItem Content="Сначала популярные"/>
                </ComboBox>

                <Button Grid.Column="3" Content="⟳ Обновить" Classes="ghost"
                        Click="ReloadClick" Margin="10,0,0,0"/>
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="CountText" Classes="muted" FontSize="12" VerticalAlignment="Center"/>
                <CheckBox Grid.Column="1" x:Name="InStockOnly" Content="Только в наличии"
                          IsCheckedChanged="InStockChanged"/>
            </Grid>
        </StackPanel>

        <Grid>
            <!-- СЕТКА КАРТОЧЕК -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="CardsList" Margin="-8,0,-8,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- КАРТОЧКА ИГРЫ (Tag хранит ProductCard для обработчика клика) -->
                            <Border Classes="gameCard" Background="{Binding CardBackground}" CornerRadius="20"
                                    Margin="9" Width="272" ClipToBounds="True"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Cursor="Hand" PointerPressed="Card_PointerPressed" Tag="{Binding}">
                                <Grid RowDefinitions="186,Auto">

                                    <!-- Фото игры + плашки поверх -->
                                    <Image Grid.Row="0" Source="{Binding Image}"
                                           Stretch="UniformToFill" Height="186" Width="272"/>
                                    <Border Grid.Row="0" Classes="badge" Margin="12"
                                            VerticalAlignment="Top" HorizontalAlignment="Right"
                                            Background="{Binding BadgeBackground}">
                                        <TextBlock Text="{Binding BadgeText}"
                                                   Foreground="{Binding BadgeForeground}"/>
                                    </Border>
                                    <Border Grid.Row="0" Margin="12" Padding="10,3" CornerRadius="10"
                                            VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                            Background="#CC1D1B2C">
                                        <TextBlock Text="{Binding Category}" Foreground="White"
                                                   FontSize="11" FontWeight="SemiBold"/>
                                    </Border>

                                    <StackPanel Grid.Row="1" Spacing="4" Margin="16,12,16,16">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        <TextBlock Classes="muted" FontSize="12">
                                            <Run Text="{Binding Details, Mode=OneWay}"/>
                                            <Run Text="{Binding Path=Article, Mode=OneWay, StringFormat={} · {0}}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding StockText}" FontSize="12"
                                                   Foreground="{StaticResource WarningBrush}"/>

                                        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding OldPriceText}" FontSize="12" Classes="muted"
                                                           TextDecorations="Strikethrough"
                                                           IsVisible="{Binding HasDiscount}"/>
                                                <TextBlock Text="{Binding PriceText}" FontWeight="Black" FontSize="19"
                                                           Foreground="{StaticResource BrandDarkBrush}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="В корзину" Classes="primary"
                                                    FontSize="13" Padding="16,8" VerticalAlignment="Center"
                                                    IsEnabled="{Binding InStock}" Tag="{Binding}"
                                                    Click="AddToCartClick"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Пустой результат поиска -->
            <StackPanel x:Name="EmptyPanel" IsVisible="False" Spacing="6"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Ничего не найдено" Classes="h2" HorizontalAlignment="Center"/>
                <TextBlock Text="Измените условия поиска или выберите «Все категории»" Classes="muted" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </DockPanel>

    <UserControl.Styles>
        <!-- Карточка слегка «приподнимается» при наведении -->
        <Style Selector="Border.gameCard">
            <Setter Property="BoxShadow" Value="0 1 3 #0F2A2163"/>
        </Style>
        <Style Selector="Border.gameCard:pointerover">
            <Setter Property="BoxShadow" Value="0 10 26 #2E2A2163"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>
    </UserControl.Styles>
</UserControl>
