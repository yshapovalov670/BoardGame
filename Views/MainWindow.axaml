<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="BoardGame.Views.MainWindow"
        Title="Магазин настольных игр"
        Width="1200" Height="760" MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Icon="avares://BoardGame/Assets/app.ico">

    <Grid RowDefinitions="Auto,*">

        <!-- 1. ВЕРХНЯЯ ПАНЕЛЬ: логотип, меню, пользователь -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}"
                BorderBrush="{StaticResource HeaderLineBrush}" BorderThickness="0,0,0,1"
                Padding="24,10" BoxShadow="0 2 12 #0F2A2163">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Логотип -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Image Source="avares://BoardGame/Assets/logo.png" Width="42" Height="42"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="BoardGames" FontSize="18" FontWeight="Black"
                                   Foreground="{StaticResource BrandDarkBrush}"/>
                        <TextBlock Text="магазин настольных игр" Classes="muted" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Пункты меню -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="36,0,0,0"
                            VerticalAlignment="Center">
                    <Button x:Name="CatalogButton" Content="Каталог" Classes="nav" Click="CatalogClick"/>
                    <Button x:Name="CartButton" Classes="nav" Click="CartClick" IsVisible="False">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock Text="Корзина" VerticalAlignment="Center"/>
                            <Border x:Name="CartBadge" Background="{StaticResource HighlightBrush}" CornerRadius="9"
                                    MinWidth="20" Padding="6,1" IsVisible="False">
                                <TextBlock x:Name="CartCountText" Text="0" Foreground="{StaticResource BrandDarkBrush}"
                                           FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button x:Name="OrdersButton" Content="Мои заказы" Classes="nav" Click="OrdersClick" IsVisible="False"/>

                    <!-- Раздел «Управление» (только администратор): по нажатию открывается список -->
                    <Button x:Name="AdminButton" Classes="nav" IsVisible="False">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Управление" VerticalAlignment="Center"/>
                            <TextBlock Text="▾" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuItem x:Name="ProductsItem" Header="Товары" Click="ProductsClick"/>
                                <MenuItem x:Name="EmployeesItem" Header="Сотрудники" Click="EmployeesClick"/>
                                <MenuItem x:Name="StaffItem" Header="Новый сотрудник" Click="StaffClick"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <!-- Пользователь и вход/выход -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="22" Padding="4,4,14,4">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource AccentBrush}">
                                <TextBlock x:Name="AvatarText" Text="Г" Foreground="White" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" MaxWidth="190">
                                <TextBlock x:Name="UserText" Text="Гость" FontWeight="SemiBold" FontSize="13"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                <TextBlock x:Name="RoleText" Text="без входа" Classes="muted" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Button x:Name="AuthButton" Content="Войти" Classes="primary" Click="LogoutOrLoginClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. РАБОЧАЯ ОБЛАСТЬ -->
        <Grid Grid.Row="1">
            <ContentControl x:Name="PageHost" Margin="32,22"/>

            <!-- Всплывающее уведомление (внизу по центру, скрывается само) -->
            <Border x:Name="Toast" IsVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,28" MaxWidth="520"
                    CornerRadius="22" Padding="20,12" BoxShadow="0 8 24 #332A2163"
                    PointerPressed="ToastPressed" Cursor="Hand">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock x:Name="ToastIcon" Text="✓" FontWeight="Bold" FontSize="16" Margin="0,0,10,0"/>
                    <TextBlock x:Name="ToastText" Grid.Column="1" FontWeight="SemiBold"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
